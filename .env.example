# Copy to .env and fill in. Never commit .env.

# --- Backend (FastAPI) -------------------------------------------------------
# Gemini API key, paid tier. Required.
GEMINI_API_KEY=

# Optional model overrides. Defaults are in src/resume_agent/llm.py.
# GEMINI_CHEAP_MODEL=gemini-flash-lite-latest
# GEMINI_STRONG_MODEL=gemini-flash-latest
# GEMINI_JUDGE_MODEL=
# GEMINI_AGENT_MODEL=

# "dev" turns the bot check off when TURNSTILE_SECRET is empty. Anything else
# (the default is "production") refuses every run until the secret is set.
APP_ENV=dev

# Cloudflare Turnstile secret key. Required in production.
TURNSTILE_SECRET=

# Frontend addresses allowed to call the API, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000

# Runs allowed per day: everyone together, and one IP address.
DAILY_RUN_CAP=100
RUNS_PER_IP=3

# Number of proxies in front of the app. Used to read the real visitor IP.
TRUSTED_PROXY_HOPS=1

# Path to a saved run (web/public/example.json). When set, /api/run replays it
# and calls no model. For frontend work only. Leave empty in production.
REPLAY_FILE=

# --- Frontend (Next.js, set in Vercel or web/.env.local) ---------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
